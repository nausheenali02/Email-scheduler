PORT=5001
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/email_scheduler?schema=public"
REDIS_URL="redis://localhost:6380"

# Worker & Email Throttling Settings
WORKER_CONCURRENCY=5
DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# Optional Custom SMTP Settings (Ethereal test account used if unconfigured)
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_USER=your_user
# SMTP_PASS=your_pass
